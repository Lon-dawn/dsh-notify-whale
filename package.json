{
  "name": "dsh-notify-whale",
  "version": "0.6.2",
  "description": "鲸吟通知（dsh-notify-whale）：会话完成、出错、等待审批或提问时推送到手机（Bark / ntfy / Server酱）与桌面，点通知直达会话。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "config.mjs",
    "config-schema.mjs",
    "dedupe.mjs",
    "format.mjs",
    "self-test.mjs",
    "paths.mjs",
    "menu.mjs",
    "menu-core.mjs",
    "scripts/install-smoke.mjs",
    "scripts/install-smoke.sh",
    "channels/",
    "assets/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "for f in *.mjs *.js channels/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test *.test.mjs channels/*.test.mjs scripts/*.test.mjs",
    "test:client": "node client.verify.mjs && node css.verify.mjs && node titles.verify.mjs && node bark-group.verify.mjs",
    "verify-client": "node client.verify.mjs",
    "self-test": "node self-test.mjs",
    "menu": "node menu.mjs",
    "smoke": "bash scripts/install-smoke.sh",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "js-yaml": "^4.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notification",
    "task-completion",
    "turn-outcome",
    "bark",
    "ntfy",
    "plugin",
    "settings",
    "notification-group"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lon-dawn/dsh-notify-whale.git"
  },
  "homepage": "https://github.com/Lon-dawn/dsh-notify-whale#readme",
  "bugs": {
    "url": "https://github.com/Lon-dawn/dsh-notify-whale/issues"
  }
}

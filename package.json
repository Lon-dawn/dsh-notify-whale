{
  "name": "dsh-notify-whale",
  "version": "0.4.2",
  "description": "椴稿悷锛坉sh-notify-whale锛夛細DSH 閫氱煡鎻掍欢鍔犲浐 fork銆備慨澶嶄笂娓稿湪 Node 22/24 涓?HTTP 閫氶亾瀹屽叏鏃犳硶鎶曢€掔瓑 5 涓繀鐜?bug锛涙柊澧炪€岀瓑寰呭鎵?鎻愰棶涔熼€氱煡銆嶄笌浜嬩欢绾?Bark 閾冨０銆侫I 涓诲淇敼銆?Hardened fork of dsh-task-notify.)",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "config.mjs",
    "dedupe.mjs",
    "format.mjs",
    "self-test.mjs",
    "paths.mjs",
    "menu.mjs",
    "menu-core.mjs",
    "scripts/install-smoke.mjs",
    "scripts/install-smoke.sh",
    "channels/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "for f in *.mjs channels/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test *.test.mjs channels/*.test.mjs scripts/*.test.mjs",
    "self-test": "node self-test.mjs",
    "menu": "node menu.mjs",
    "smoke": "bash scripts/install-smoke.sh",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notification",
    "task-completion",
    "turn-outcome",
    "bark",
    "ntfy",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lon-dawn/dsh-notify-whale.git"
  },
  "homepage": "https://github.com/Lon-dawn/dsh-notify-whale#readme",
  "bugs": {
    "url": "https://github.com/Lon-dawn/dsh-notify-whale/issues"
  }
